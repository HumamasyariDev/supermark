[gd_scene load_steps=5 format=3]

[ext_resource type="Script" path="res://scripts/fx/blob_shadow.gd" id="1_blob"]

[sub_resource type="Shader" id="Shader_blob"]
code = "// Retro blob shadow (D032/D034): soft round contact shadow with a slightly stepped core, tinted plum, not black.
shader_type spatial;
render_mode unshaded, cull_disabled, depth_draw_never, shadows_disabled;

instance uniform float alpha = 0.5;
uniform vec3 tint : source_color = vec3(0.07, 0.045, 0.09);

void fragment() {
	float d = length(UV - vec2(0.5)) * 2.0;
	float core = 1.0 - smoothstep(0.5, 0.62, d);
	float soft = 1.0 - smoothstep(0.55, 1.0, d);
	ALBEDO = tint;
	ALPHA = alpha * clamp(soft * 0.75 + core * 0.25, 0.0, 1.0);
}
"

[sub_resource type="ShaderMaterial" id="Mat_blob"]
render_priority = -1
shader = SubResource("Shader_blob")
shader_parameter/tint = Color(0.07, 0.045, 0.09, 1)

[sub_resource type="PlaneMesh" id="Plane_blob"]
size = Vector2(2, 2)

[node name="BlobShadow" type="MeshInstance3D"]
top_level = true
cast_shadow = 0
mesh = SubResource("Plane_blob")
surface_material_override/0 = SubResource("Mat_blob")
script = ExtResource("1_blob")
