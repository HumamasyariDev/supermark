; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Super Mak 64"
config/description="An original storybook 3D platformer starring Mr. Mak, the gentleman piglet."
run/main_scene="res://scenes/boot/Boot.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
boot_splash/bg_color=Color(0.965, 0.91, 0.784, 1)
boot_splash/stretch_mode=0
boot_splash/image="res://assets/ui/logo_1024.png"
config/icon="res://icon.svg"

[autoload]

RunGovernor="*res://scripts/core/run_governor.gd"
WebRuntime="*res://scripts/core/web_runtime.gd"
Dev="*res://scripts/core/dev_tools.gd"
Controls="*res://scripts/core/controls.gd"
Game="*res://scripts/core/game_state.gd"
Audio="*res://scripts/core/audio_manager.gd"
Router="*res://scripts/core/scene_router.gd"
UI="*res://scripts/ui/ui_root.gd"
Juice="*res://scripts/fx/juice.gd"
RetroLook="*res://scripts/fx/retro_look.gd"
P0Bridge="*res://scripts/core/p0_bridge.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1600
window/size/window_height_override=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="player"
3d_physics/layer_3="enemy"
3d_physics/layer_4="pickup"
3d_physics/layer_5="hazard"
3d_physics/layer_6="player_attack"
3d_physics/layer_7="enemy_hurtbox"
3d_physics/layer_8="trigger"
3d_physics/layer_9="camera_ignore"

[physics]

3d/physics_engine="Jolt Physics"
common/physics_interpolation=true

[rendering]

lights_and_shadows/directional_shadow/size=8192
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
lights_and_shadows/positional_shadow/soft_shadow_filter_quality=3
anti_aliasing/quality/msaa_3d=2
environment/defaults/default_clear_color=Color(0.55, 0.74, 0.93, 1)
anti_aliasing/quality/msaa_3d.web=0
anti_aliasing/quality/screen_space_aa.web=0
driver/depth_prepass/enable.web=false
lights_and_shadows/directional_shadow/size.web=4096
lights_and_shadows/positional_shadow/atlas_size.web=2048
